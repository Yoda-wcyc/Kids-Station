{
  "_doc": "小朋友鎮的英文小對話。每段 3–5 回合：npc＝居民說的話（英文＋中文），cards＝小朋友可以選的回答（ok:true 只有一張），最後 check＝理解小測驗（中文選項）。答對（第一次就選對）+1 金幣，小測驗答對 +2。",
  "school": { "place": "School", "turns": [
    { "npc": "Good morning! Are you ready for class?", "zh": "早安！準備好上課了嗎？", "cards": [{ "en": "Yes, I'm ready!", "ok": true }, { "en": "I'm a dog.", "ok": false }, { "en": "It's raining apples.", "ok": false }] },
    { "npc": "Great. Please take out your book.", "zh": "很好。請拿出你的課本。", "cards": [{ "en": "OK. Here it is.", "ok": true }, { "en": "I like pizza.", "ok": false }, { "en": "Good night!", "ok": false }] },
    { "npc": "What color is the sky?", "zh": "天空是什麼顏色？", "cards": [{ "en": "It's blue.", "ok": true }, { "en": "It's Tuesday.", "ok": false }, { "en": "I'm ten years old.", "ok": false }] },
    { "npc": "Well done! See you tomorrow.", "zh": "做得好！明天見。", "cards": [{ "en": "See you, Ms. Lin!", "ok": true }, { "en": "Yes, I'm hungry.", "ok": false }, { "en": "Two apples, please.", "ok": false }] }],
    "check": { "q": "老師請你拿出什麼？", "options": ["課本", "鉛筆盒", "水壺"], "answer": 0 } },
