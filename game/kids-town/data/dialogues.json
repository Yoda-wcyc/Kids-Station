    { "npc": "Oh no. When did it start?", "zh": "喔不。什麼時候開始的？", "cards": [{ "en": "This morning.", "ok": true }, { "en": "Blue and green.", "ok": false }, { "en": "Yes, please.", "ok": false }] },
    { "npc": "Drink some water and get some rest.", "zh": "多喝水，好好休息。", "cards": [{ "en": "OK. Thank you, doctor.", "ok": true }, { "en": "I want a cat.", "ok": false }, { "en": "No, it's a book.", "ok": false }] },
