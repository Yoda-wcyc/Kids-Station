    { "npc": "Found you! That was fun.", "zh": "找到你了！好好玩。", "cards": [{ "en": "Let's play again tomorrow.", "ok": true }, { "en": "Turn right at the bank.", "ok": false }, { "en": "I'm a firefighter.", "ok": false }] }],
