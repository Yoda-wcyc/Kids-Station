  "vet": { "place": "Animal Hospital", "turns": [
    { "npc": "Hi! Is this your puppy?", "zh": "嗨！這是你的小狗嗎？", "cards": [{ "en": "Yes. His name is Lucky.", "ok": true }, { "en": "Yes. I'm eleven.", "ok": false }, { "en": "No, it's a bus.", "ok": false }] },
    { "npc": "What's wrong with Lucky?", "zh": "Lucky 怎麼了？", "cards": [{ "en": "He doesn't want to eat.", "ok": true }, { "en": "He is brown.", "ok": false }, { "en": "He can sing.", "ok": false }] },
