    { "npc": "Hi! Do you want to play with me?", "zh": "嗨！你想跟我一起玩嗎？", "cards": [{ "en": "Sure! What do you want to play?", "ok": true }, { "en": "I have a headache.", "ok": false }, { "en": "It's thirty dollars.", "ok": false }] },
    { "npc": "Let's play hide-and-seek!", "zh": "我們來玩捉迷藏！", "cards": [{ "en": "OK! You count first.", "ok": true }, { "en": "I'm eating noodles.", "ok": false }, { "en": "Please open your book.", "ok": false }] },
