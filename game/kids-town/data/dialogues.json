    { "npc": "Good. Stay low under the smoke.", "zh": "很好。在煙的下面，身體要放低。", "cards": [{ "en": "OK. Stay low.", "ok": true }, { "en": "Let's jump high!", "ok": false }, { "en": "It's my birthday.", "ok": false }] },
    { "npc": "You are a fire safety star!", "zh": "你是防火小達人！", "cards": [{ "en": "Thank you, Sam!", "ok": true }, { "en": "See you at school.", "ok": false }, { "en": "Two dollars, please.", "ok": false }] }],
    "check": { "q": "失火時要打幾號？", "options": ["119", "110", "123"], "answer": 0 } },
  "post": { "place": "Post Office", "turns": [
    { "npc": "Hello! Do you want to send a letter?", "zh": "哈囉！你要寄信嗎？", "cards": [{ "en": "Yes. It's for my grandma.", "ok": true }, { "en": "No, I'm a teacher.", "ok": false }, { "en": "It's very hot.", "ok": false }] },
    { "npc": "Where does she live?", "zh": "她住在哪裡？", "cards": [{ "en": "She lives in Tainan.", "ok": true }, { "en": "She is seventy.", "ok": false }, { "en": "She likes cats.", "ok": false }] },
    { "npc": "You need a stamp. It's ten dollars.", "zh": "要貼一張郵票，十元。", "cards": [{ "en": "OK. Here is ten dollars.", "ok": true }, { "en": "I need a hat.", "ok": false }, { "en": "Ten o'clock.", "ok": false }] },
