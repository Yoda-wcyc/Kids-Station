    { "npc": "Yes. Keep him warm, and he will be fine.", "zh": "會的。讓牠保暖，就會好起來。", "cards": [{ "en": "Thank you, Dr. Amy!", "ok": true }, { "en": "Keep it cold.", "ok": false }, { "en": "Good night, Lucky.", "ok": false }] }],
    "check": { "q": "小狗 Lucky 怎麼了？", "options": ["有一點感冒", "腳受傷", "太胖了"], "answer": 0 } },
  "neighbor": { "place": "My Street", "turns": [
    { "npc": "Hi there! Are you new here?", "zh": "嗨！你是新搬來的嗎？", "cards": [{ "en": "Yes. I live in that house.", "ok": true }, { "en": "Yes, it's a pencil.", "ok": false }, { "en": "No, it's Friday.", "ok": false }] },
    { "npc": "Welcome to Kids Town! What's your favorite place?", "zh": "歡迎來到小朋友鎮！你最喜歡哪裡？", "cards": [{ "en": "I like the park.", "ok": true }, { "en": "I'm fine, thanks.", "ok": false }, { "en": "Three apples.", "ok": false }] },
